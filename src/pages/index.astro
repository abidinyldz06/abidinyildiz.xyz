---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import TopNav from '../components/TopNav.astro';
import RightPanel from '../components/RightPanel.astro';
import NoteCard from '../components/NoteCard.astro';
import PlantSeedCard from '../components/PlantSeedCard.astro';

import { getCollection } from 'astro:content';
import { getStageInfo, daysSince, formatTimeSince, needsWater } from '../lib/growth';

const seeds = await getCollection('seeds');
const leaves = await getCollection('leaves');

// Build seed cards with real growth calculation
const seedCards = seeds.map((seed) => {
  const plantedAt = new Date(seed.data.plantedAt);
  const stageInfo = getStageInfo(plantedAt);
  
  // Count leaves for this seed
  const seedLeaves = leaves.filter(l => l.data.seedRef === seed.id);
  const leafCount = seedLeaves.length;
  
  // Find last leaf date
  const lastLeafDate = seedLeaves.length > 0
    ? new Date(Math.max(...seedLeaves.map(l => l.data.date.getTime())))
    : null;
  
  return {
    title: seed.data.title,
    description: seed.data.description,
    slug: seed.id,
    icon: seed.data.icon,
    stage: stageInfo,
    leafCount,
    lastWatered: lastLeafDate ? formatTimeSince(lastLeafDate) : 'Hiç sulanmadı',
    needsWater: needsWater(lastLeafDate),
    plantedAt,
  };
}).sort((a, b) => b.plantedAt.getTime() - a.plantedAt.getTime());
---

<Base title="Yaşayan Orman — Dijital Ekosistem">
  
  <Sidebar />

  <main class="flex-1 h-full flex flex-col relative z-10">
    <TopNav />
    
    <div class="flex-1 overflow-y-auto overflow-x-hidden p-8 pb-20">
      <div class="max-w-7xl mx-auto flex gap-12">
        
        <!-- Main Content Area -->
        <div class="flex-1">
          <div class="flex items-start justify-between mb-8">
            <div>
              <h2 class="text-4xl md:text-5xl font-serif font-extrabold text-forest-text-light dark:text-forest-text-dark mb-2 tracking-tight">Fidanlık</h2>
              <p class="text-forest-text-light/60 dark:text-forest-text-dark/60">Aktif tohumlar ve büyüyen konseptler.</p>
            </div>
            
            <div class="flex gap-2">
              <button id="filter-toggle" class="w-10 h-10 rounded-full bg-forest-text-light/5 dark:bg-white/5 border border-forest-accent-light/20 dark:border-forest-accent-dark/20 flex items-center justify-center hover:bg-forest-text-light/10 dark:hover:bg-white/10 transition-colors">
                <span class="text-forest-text-light dark:text-forest-text-dark">≡</span>
              </button>
            </div>
          </div>

          <!-- Filters -->
          <div class="flex gap-2 mb-10 flex-wrap" id="filter-bar">
            <button data-filter="all" class="filter-btn active px-4 py-1.5 rounded-md text-sm font-bold bg-forest-text-light text-white dark:bg-forest-card-dark dark:text-forest-text-dark border border-forest-text-light dark:border-forest-accent-dark/20 hover:opacity-90 transition-all shadow-lg dark:shadow-forest-glow/10">
              Tümü
            </button>
            <button data-filter="seed" class="filter-btn px-4 py-1.5 rounded-md text-sm font-bold bg-forest-text-light/10 text-forest-text-light dark:bg-white/5 dark:text-forest-text-dark/80 hover:bg-forest-text-light/20 dark:hover:bg-white/10 transition-colors">
              🌱 Tohum
            </button>
            <button data-filter="seedling" class="filter-btn px-4 py-1.5 rounded-md text-sm font-bold bg-forest-text-light/10 text-forest-text-light dark:bg-white/5 dark:text-forest-text-dark/80 hover:bg-forest-text-light/20 dark:hover:bg-white/10 transition-colors">
              🌿 Fidan
            </button>
            <button data-filter="sapling" class="filter-btn px-4 py-1.5 rounded-md text-sm font-bold bg-forest-text-light/10 text-forest-text-light dark:bg-white/5 dark:text-forest-text-dark/80 hover:bg-forest-text-light/20 dark:hover:bg-white/10 transition-colors">
              🌳 Genç Ağaç
            </button>
            <button data-filter="tree" class="filter-btn px-4 py-1.5 rounded-md text-sm font-bold bg-forest-text-light/10 text-forest-text-light dark:bg-white/5 dark:text-forest-text-dark/80 hover:bg-forest-text-light/20 dark:hover:bg-white/10 transition-colors">
              🌲 Kadim Ağaç
            </button>
          </div>

          <!-- Cards Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="seeds-grid">
            {seedCards.map((seed) => (
              <a href={`/seeds/${seed.slug}`} class="dashboard-card group flex flex-col h-full relative overflow-hidden block" data-stage={seed.stage.key}>
                
                <div class="flex justify-between items-start mb-6">
                  <div class="w-14 h-14 rounded-full bg-forest-text-light/10 dark:bg-forest-card-dark border border-forest-accent-light/20 dark:border-forest-accent-dark/20 flex items-center justify-center text-2xl group-hover:scale-110 group-hover:border-forest-accent-light dark:group-hover:border-forest-accent-dark transition-all duration-300 shadow-inner group-hover:shadow-[0_0_15px_rgba(74,222,128,0.3)]">
                    {seed.icon}
                  </div>
                  
                  <div class="flex items-center gap-2">
                    {seed.needsWater && (
                      <span class="text-xs px-2 py-0.5 rounded-md bg-red-500/10 text-red-500 dark:text-red-400 font-bold">💧 Sulanmalı</span>
                    )}
                    <span class={`text-xs font-bold px-3 py-1 rounded-md ${seed.stage.color}`}>
                      {seed.stage.icon} {seed.stage.label}
                    </span>
                  </div>
                </div>

                <div class="flex-1">
                  <h3 class="text-xl font-serif font-bold text-forest-text-light dark:text-forest-text-dark mb-2 group-hover:text-forest-accent-light dark:group-hover:text-forest-accent-dark transition-colors">
                    {seed.title}
                  </h3>
                  <p class="text-sm text-forest-text-light/60 dark:text-forest-text-dark/60 line-clamp-2 leading-relaxed">
                    {seed.description}
                  </p>
                </div>

                <div class="mt-6 flex items-center justify-between text-xs text-forest-text-light/50 dark:text-forest-text-dark/50 border-t border-forest-accent-light/10 dark:border-forest-accent-dark/10 pt-4">
                  <div class="flex items-center gap-1.5 px-2 py-1 bg-black/5 dark:bg-black/30 rounded-full">
                    <span>🍃</span>
                    <span class="font-bold">{seed.leafCount} yaprak</span>
                  </div>
                  
                  <span class="font-medium">Son: {seed.lastWatered}</span>
                </div>
              </a>
            ))}
            
            <PlantSeedCard />
          </div>
          
        </div>
        
        <RightPanel />

      </div>
    </div>
  </main>
  
</Base>

<script>
  // Filter functionality
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;
      
      // Update active button
      document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.remove('!bg-forest-text-light', '!text-white', 'dark:!bg-forest-card-dark', 'dark:!text-forest-text-dark', 'shadow-lg', 'active');
        b.classList.add('bg-forest-text-light/10', 'dark:bg-white/5');
      });
      btn.classList.add('!bg-forest-text-light', '!text-white', 'dark:!bg-forest-card-dark', 'dark:!text-forest-text-dark', 'shadow-lg', 'active');
      btn.classList.remove('bg-forest-text-light/10', 'dark:bg-white/5');
      
      // Filter cards
      document.querySelectorAll('#seeds-grid > *').forEach(card => {
        const el = card as HTMLElement;
        if (filter === 'all' || el.dataset.stage === filter || !el.dataset.stage) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });
</script>
