---
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';
---

<Base title="Sayfa Bulunamadı — Yaşayan Orman" description="Aradığınız sayfa Yaşayan Orman’da bulunamadı.">
  <main id="main-content" class="flex-1 min-w-0 h-full flex flex-col relative z-10">
    <TopNav />
    <div class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 grid place-items-center">
      <section class="max-w-xl w-full dashboard-card p-8 sm:p-12 text-center">
        <span class="text-6xl block mb-6" aria-hidden="true">🍂</span>
        <p class="text-xs font-bold uppercase tracking-[0.3em] text-forest-accent-light dark:text-forest-accent-dark mb-3">404</p>
        <h1 class="text-3xl sm:text-4xl font-serif font-extrabold text-forest-text-light dark:text-forest-text-dark mb-4">Bu patika kaybolmuş</h1>
        <p class="text-forest-text-light/60 dark:text-forest-text-dark/60 mb-8">Aradığın sayfa taşınmış, silinmiş veya henüz bu ormanda büyümemiş olabilir.</p>
        <div class="flex flex-col sm:flex-row justify-center gap-3">
          <a href="/" class="rounded-xl bg-forest-text-light dark:bg-forest-accent-dark text-white dark:text-black px-5 py-3 font-bold">Fidanlığa dön</a>
          <a href="/kulliyat" class="rounded-xl bg-black/5 dark:bg-white/5 px-5 py-3 font-bold">Külliyatı aç</a>
        </div>
      </section>
    </div>
  </main>
</Base>
