---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import TopNav from '../components/TopNav.astro';

import { getCollection } from 'astro:content';

const seeds = await getCollection('seeds');
const leaves = await getCollection('leaves');

// Prepare graph data
const graphNodes = [
  { id: 'root', label: '🌲 Yaşayan Orman (Öz)', group: 0, val: 20 }
];

seeds.forEach(s => {
  graphNodes.push({
    id: s.id,
    label: `${s.data.icon} ${s.data.title}`,
    group: 1, // seed
    val: leaves.filter(l => l.data.seedRef === s.id).length * 2 + 10 // size
  });
});

leaves.forEach(l => {
  graphNodes.push({
    id: l.id,
    label: l.data.title,
    group: 2, // leaf
    val: 4 // size
  });
});

const graphLinks: Array<{ source: string; target: string }> = [];

// Connect seeds to root
seeds.forEach(s => {
  graphLinks.push({
    source: 'root',
    target: s.id
  });
});

// Connect leaves to seeds
leaves.forEach(l => {
  graphLinks.push({
    source: l.data.seedRef,
    target: l.id
  });
});

const graphData = {
  nodes: graphNodes,
  links: graphLinks
};
---

<Base title="Yaşayan Orman — Ekosistem">
  <Sidebar />
  <main class="flex-1 h-full flex flex-col relative z-10">
    <TopNav />
    
    <div class="flex-1 p-8 flex flex-col h-full">
      <div class="mb-4">
        <h2 class="text-3xl font-serif font-extrabold text-forest-text-light dark:text-forest-text-dark">Orman Ekosistemi</h2>
        <p class="text-forest-text-light/60 dark:text-forest-text-dark/60">Fikirlerinin birbirine nasıl bağlandığını keşfet.</p>
      </div>

      <!-- Graph Container -->
      <div id="graph-container" class="flex-1 bg-white/30 dark:bg-black/20 border border-forest-accent-light/20 dark:border-forest-accent-dark/20 rounded-2xl overflow-hidden relative shadow-inner">
        <!-- Loading overlay -->
        <div id="loading" class="absolute inset-0 flex items-center justify-center text-forest-text-light/50 dark:text-forest-text-dark/50">
          Zihin haritası yükleniyor...
        </div>
      </div>
    </div>
  </main>
</Base>

<!-- Force Graph Library -->
<script src="https://unpkg.com/force-graph"></script>

<script is:inline define:vars={{ graphData }}>
  // Ensure the library is loaded before executing
  window.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('graph-container');
    const loading = document.getElementById('loading');
    
    if (container && window.ForceGraph) {
      if (loading) loading.style.display = 'none';
      
      const isDark = document.documentElement.classList.contains('dark');
      
      const Graph = ForceGraph()(container)
        .graphData(graphData)
        .nodeLabel('label')
        .nodeColor(node => {
          if (node.group === 0) return isDark ? '#fbbf24' : '#d97706'; // Root color (amber/gold)
          if (node.group === 1) return isDark ? '#4ade80' : '#6ba887'; // Seed color
          return isDark ? '#e0eee6' : '#2d4a3e'; // Leaf color
        })
        .linkColor(() => isDark ? 'rgba(74,222,128,0.2)' : 'rgba(107,168,135,0.2)')
        .backgroundColor('transparent')
        .nodeVal('val')
        .dagMode('td') // Top-Down Tree Layout
        .dagLevelDistance(60) // Distance between levels
        .linkDirectionalParticles(2)
        .linkDirectionalParticleSpeed(d => d.value * 0.001 || 0.005)
        .linkDirectionalParticleWidth(2)
        .onNodeClick(node => {
          if (node.group === 1) {
            window.location.href = `/seeds/${node.id}`;
          } else if (node.group === 2) {
            window.location.href = `/leaves/${node.id}`;
          }
        });

      // Handle resize
      const resizeObserver = new ResizeObserver(() => {
        Graph.width(container.clientWidth).height(container.clientHeight);
      });
      resizeObserver.observe(container);
    }
  });
</script>
