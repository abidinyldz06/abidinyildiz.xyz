---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import TopNav from '../components/TopNav.astro';
import { getCollection } from 'astro:content';

const seeds = await getCollection('seeds');
const leaves = await getCollection('leaves');
const branches = seeds.map(seed => ({
  seed,
  leaves: leaves
    .filter(leaf => leaf.data.seedRef === seed.id)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
})).sort((a, b) => b.leaves.length - a.leaves.length);
---

<Base title="Ekosistem — Yaşayan Orman" description="Yaşayan Orman’daki fikirlerin ve yazıların bağlantı haritası.">
  <Sidebar />
  <main id="main-content" class="flex-1 h-full min-w-0 flex flex-col relative z-10">
    <TopNav />
    <div class="flex-1 overflow-y-auto overflow-x-hidden p-4 sm:p-6 lg:p-8 pb-20">
      <div class="max-w-6xl mx-auto">
        <div class="mb-10">
          <p class="text-xs font-bold uppercase tracking-[0.25em] text-forest-accent-light dark:text-forest-accent-dark mb-3">Bağlantı haritası</p>
          <h1 class="text-4xl md:text-5xl font-serif font-extrabold text-forest-text-light dark:text-forest-text-dark mb-3">Orman Ekosistemi</h1>
          <p class="max-w-2xl text-forest-text-light/60 dark:text-forest-text-dark/60">Her ağaç bir ana konuyu, dallarındaki yapraklar ise o konuyu büyüten yazıları gösterir. Haritadaki her öğe gerçek bir sayfaya açılır.</p>
        </div>

        <section aria-label="Orman özeti" class="relative dashboard-card p-6 sm:p-8 mb-8 overflow-hidden">
          <div class="absolute inset-y-0 left-0 w-1.5 bg-gradient-to-b from-forest-accent-light to-emerald-300 dark:from-forest-accent-dark dark:to-emerald-700"></div>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
            <div class="flex items-center gap-5">
              <span class="w-16 h-16 rounded-2xl bg-forest-accent-light/10 dark:bg-forest-accent-dark/10 flex items-center justify-center text-3xl" aria-hidden="true">🌲</span>
              <div><h2 class="text-2xl font-serif font-bold text-forest-text-light dark:text-forest-text-dark">Yaşayan Orman</h2><p class="text-sm text-forest-text-light/55 dark:text-forest-text-dark/55 mt-1">Fikirlerden yazılara uzanan kişisel bilgi ağı</p></div>
            </div>
            <dl class="flex gap-6 text-center">
              <div><dt class="text-xs uppercase tracking-widest text-forest-text-light/45 dark:text-forest-text-dark/45">Ağaç</dt><dd class="text-2xl font-black mt-1">{seeds.length}</dd></div>
              <div><dt class="text-xs uppercase tracking-widest text-forest-text-light/45 dark:text-forest-text-dark/45">Yaprak</dt><dd class="text-2xl font-black mt-1">{leaves.length}</dd></div>
            </dl>
          </div>
        </section>

        <div class="grid lg:grid-cols-2 gap-6">
          {branches.map(({ seed, leaves: seedLeaves }) => (
            <section class="dashboard-card p-6 sm:p-7 relative">
              <div class="absolute left-0 top-10 bottom-10 w-px bg-forest-accent-light/20 dark:bg-forest-accent-dark/20"></div>
              <a href={`/seeds/${seed.id}`} class="group flex items-start gap-4 mb-6">
                <span class="w-14 h-14 shrink-0 rounded-2xl bg-forest-accent-light/10 dark:bg-forest-accent-dark/10 flex items-center justify-center text-2xl group-hover:scale-105 transition-transform">{seed.data.icon}</span>
                <span class="min-w-0">
                  <span class="text-xs uppercase tracking-widest font-bold text-forest-accent-light dark:text-forest-accent-dark">{seedLeaves.length} yaprak</span>
                  <strong class="block text-xl font-serif text-forest-text-light dark:text-forest-text-dark group-hover:text-forest-accent-light dark:group-hover:text-forest-accent-dark mt-1">{seed.data.title}</strong>
                  <span class="block text-sm text-forest-text-light/55 dark:text-forest-text-dark/55 mt-2">{seed.data.description}</span>
                </span>
              </a>
              {seedLeaves.length > 0 ? <div class="space-y-2 pl-5 border-l border-forest-accent-light/15 dark:border-forest-accent-dark/15 ml-7">
                {seedLeaves.map(leaf => <a href={`/leaves/${leaf.id}`} class="flex items-center justify-between gap-4 rounded-xl px-4 py-3 bg-black/[0.025] dark:bg-white/[0.025] hover:bg-forest-accent-light/10 dark:hover:bg-forest-accent-dark/10 transition-colors">
                  <span class="text-sm font-medium text-forest-text-light/80 dark:text-forest-text-dark/80"><span aria-hidden="true">🍃</span> {leaf.data.title}</span><span aria-hidden="true" class="opacity-30">→</span>
                </a>)}
              </div> : <p class="pl-5 ml-7 text-sm text-forest-text-light/40 dark:text-forest-text-dark/40">Bu dal henüz ilk yaprağını bekliyor.</p>}
            </section>
          ))}
        </div>
      </div>
    </div>
  </main>
</Base>
