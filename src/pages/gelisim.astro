---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import TopNav from '../components/TopNav.astro';

import { getCollection } from 'astro:content';
import { getStageInfo, daysSince } from '../lib/growth';

const seeds = await getCollection('seeds');
const leaves = await getCollection('leaves');

// Calculations
const totalSeeds = seeds.length;
const totalLeaves = leaves.length;

const stageCount = { seed: 0, seedling: 0, sapling: 0, tree: 0 };
seeds.forEach(s => {
  const stage = getStageInfo(new Date(s.data.plantedAt)).key;
  stageCount[stage]++;
});

// Calculate words (rough estimate based on body length, normally you'd parse markdown body)
let totalWords = 0;
leaves.forEach(l => {
  totalWords += l.body ? l.body.split(/\s+/).length : 50; // fallback if body is undefined
});

// Oldest tree
const sortedSeeds = [...seeds].sort((a, b) => new Date(a.data.plantedAt).getTime() - new Date(b.data.plantedAt).getTime());
const oldestSeed = sortedSeeds[0];
const oldestDays = oldestSeed ? daysSince(new Date(oldestSeed.data.plantedAt)) : 0;
---

<Base title="Yaşayan Orman — Gelişim">
  <Sidebar />
  <main class="flex-1 h-full flex flex-col relative z-10">
    <TopNav />
    
    <div class="flex-1 overflow-y-auto p-8">
      <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="mb-10">
          <div class="flex items-center gap-3 mb-2">
            <span class="text-3xl">📊</span>
            <h2 class="text-3xl md:text-4xl font-serif font-extrabold text-forest-text-light dark:text-forest-text-dark">Ormanın Gelişimi</h2>
          </div>
          <p class="text-forest-text-light/60 dark:text-forest-text-dark/60 ml-12">Dijital bahçenin genel sağlığı ve büyüme istatistikleri.</p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-10">
          <div class="dashboard-card p-6 text-center group">
            <span class="text-3xl mb-3 block group-hover:scale-125 transition-transform">🌱</span>
            <div class="text-3xl font-black text-forest-text-light dark:text-forest-text-dark">{totalSeeds}</div>
            <div class="text-xs uppercase tracking-widest font-bold text-forest-text-light/50 dark:text-forest-text-dark/50 mt-1">Toplam Tohum</div>
          </div>
          
          <div class="dashboard-card p-6 text-center group">
            <span class="text-3xl mb-3 block group-hover:scale-125 transition-transform">🍃</span>
            <div class="text-3xl font-black text-forest-text-light dark:text-forest-text-dark">{totalLeaves}</div>
            <div class="text-xs uppercase tracking-widest font-bold text-forest-text-light/50 dark:text-forest-text-dark/50 mt-1">Toplam Yaprak</div>
          </div>

          <div class="dashboard-card p-6 text-center group">
            <span class="text-3xl mb-3 block group-hover:scale-125 transition-transform">📝</span>
            <div class="text-3xl font-black text-forest-text-light dark:text-forest-text-dark">{totalWords}</div>
            <div class="text-xs uppercase tracking-widest font-bold text-forest-text-light/50 dark:text-forest-text-dark/50 mt-1">Kelime Hacmi</div>
          </div>

          <div class="dashboard-card p-6 text-center group">
            <span class="text-3xl mb-3 block group-hover:scale-125 transition-transform">⏳</span>
            <div class="text-3xl font-black text-forest-text-light dark:text-forest-text-dark">{oldestDays}</div>
            <div class="text-xs uppercase tracking-widest font-bold text-forest-text-light/50 dark:text-forest-text-dark/50 mt-1">En Eski Ağaç (Gün)</div>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-8">
          <!-- Yaş Dağılımı -->
          <div class="dashboard-card p-8">
            <h3 class="font-serif text-xl font-bold text-forest-text-light dark:text-forest-text-dark mb-6">Ağaçların Evreleri</h3>
            <div class="space-y-4">
              <div class="flex items-center gap-4">
                <span class="w-24 text-sm font-bold text-forest-text-light/70 dark:text-forest-text-dark/70">🌱 Tohum</span>
                <div class="flex-1 bg-black/5 dark:bg-black/30 rounded-full h-3 overflow-hidden">
                  <div class="bg-emerald-400 h-full rounded-full" style={`width: ${totalSeeds > 0 ? (stageCount.seed / totalSeeds) * 100 : 0}%`}></div>
                </div>
                <span class="text-sm font-bold w-6">{stageCount.seed}</span>
              </div>
              <div class="flex items-center gap-4">
                <span class="w-24 text-sm font-bold text-forest-text-light/70 dark:text-forest-text-dark/70">🌿 Fidan</span>
                <div class="flex-1 bg-black/5 dark:bg-black/30 rounded-full h-3 overflow-hidden">
                  <div class="bg-green-500 h-full rounded-full" style={`width: ${totalSeeds > 0 ? (stageCount.seedling / totalSeeds) * 100 : 0}%`}></div>
                </div>
                <span class="text-sm font-bold w-6">{stageCount.seedling}</span>
              </div>
              <div class="flex items-center gap-4">
                <span class="w-24 text-sm font-bold text-forest-text-light/70 dark:text-forest-text-dark/70">🌳 Genç Ağaç</span>
                <div class="flex-1 bg-black/5 dark:bg-black/30 rounded-full h-3 overflow-hidden">
                  <div class="bg-teal-500 h-full rounded-full" style={`width: ${totalSeeds > 0 ? (stageCount.sapling / totalSeeds) * 100 : 0}%`}></div>
                </div>
                <span class="text-sm font-bold w-6">{stageCount.sapling}</span>
              </div>
              <div class="flex items-center gap-4">
                <span class="w-24 text-sm font-bold text-forest-text-light/70 dark:text-forest-text-dark/70">🌲 Kadim Ağaç</span>
                <div class="flex-1 bg-black/5 dark:bg-black/30 rounded-full h-3 overflow-hidden">
                  <div class="bg-forest-accent-light dark:bg-forest-accent-dark h-full rounded-full" style={`width: ${totalSeeds > 0 ? (stageCount.tree / totalSeeds) * 100 : 0}%`}></div>
                </div>
                <span class="text-sm font-bold w-6">{stageCount.tree}</span>
              </div>
            </div>
          </div>

          <!-- Bahçıvan Profili -->
          <div class="dashboard-card p-8 flex flex-col items-center justify-center text-center">
            <h3 class="font-serif text-xl font-bold text-forest-text-light dark:text-forest-text-dark mb-6 w-full text-left">Bahçıvan Gelişimi</h3>
            <img id="stats-avatar" src="/avatars/caretaker.png" class="w-24 h-24 rounded-full border-2 border-forest-accent-light/50 dark:border-forest-accent-dark/50 mb-4 object-cover" />
            <h4 id="stats-name" class="text-xl font-bold text-forest-text-light dark:text-forest-text-dark">Bahçıvan</h4>
            <p id="stats-title" class="text-sm font-mono text-forest-accent-light dark:text-forest-accent-dark mb-4">🌲 Ormancı</p>
            
            <div class="w-full max-w-xs bg-black/5 dark:bg-black/30 rounded-full h-2 mb-2 overflow-hidden">
              <div id="stats-xp-bar" class="bg-forest-accent-light dark:bg-forest-accent-dark h-full rounded-full transition-all" style="width: 0%"></div>
            </div>
            <p id="stats-xp-text" class="text-xs font-mono text-forest-text-light/60 dark:text-forest-text-dark/60">Seviye 1 (0/100 XP)</p>
          </div>
        </div>

        <!-- Rozetler -->
        <div class="dashboard-card p-8">
          <h3 class="font-serif text-xl font-bold text-forest-text-light dark:text-forest-text-dark mb-6">Kazanılan Rozetler</h3>
          <div id="achievements-grid" class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <!-- Rozetler buraya js ile eklenecek -->
          </div>
          <p id="no-achievements" class="text-sm text-forest-text-light/50 dark:text-forest-text-dark/50 italic hidden">Henüz rozet kazanılmadı.</p>
        </div>

      </div>
    </div>
  </main>
</Base>

<script>
  import { ACHIEVEMENTS_DB } from '../lib/caretaker';

  const data = localStorage.getItem('caretaker');
  if (data) {
    try {
      const c = JSON.parse(data);
      (document.getElementById('stats-avatar') as HTMLImageElement).src = c.avatar;
      (document.getElementById('stats-name') as HTMLElement).textContent = c.name;
      (document.getElementById('stats-title') as HTMLElement).textContent = c.title;
      (document.getElementById('stats-xp-bar') as HTMLElement).style.width = `${(c.xp / c.xpToNext) * 100}%`;
      (document.getElementById('stats-xp-text') as HTMLElement).textContent = `Seviye ${c.level} (${c.xp}/${c.xpToNext} XP)`;

      // Rozetler
      const grid = document.getElementById('achievements-grid');
      const emptyMsg = document.getElementById('no-achievements');
      const achievements = c.achievements || [];
      
      if (achievements.length > 0 && grid) {
        achievements.forEach(id => {
          const badge = ACHIEVEMENTS_DB[id];
          if (badge) {
            grid.innerHTML += `
              <div class="p-4 rounded-xl bg-forest-accent-light/5 dark:bg-forest-accent-dark/5 border border-forest-accent-light/20 dark:border-forest-accent-dark/20 text-center flex flex-col items-center gap-2 group">
                <span class="text-4xl group-hover:scale-110 group-hover:rotate-12 transition-transform">${badge.icon}</span>
                <span class="font-bold text-sm text-forest-text-light dark:text-forest-text-dark">${badge.title}</span>
                <span class="text-[10px] text-forest-text-light/60 dark:text-forest-text-dark/60 leading-tight">${badge.description}</span>
              </div>
            `;
          }
        });
      } else {
        emptyMsg?.classList.remove('hidden');
      }

    } catch {}
  }
</script>
