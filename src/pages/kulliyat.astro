---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import TopNav from '../components/TopNav.astro';
import { getCollection } from 'astro:content';
import { GARDENS } from '../lib/gardens';
import { formatTimeSince } from '../lib/growth';

const notes = await getCollection('notes');
const leaves = await getCollection('leaves');
const seeds = await getCollection('seeds');

const toExcerpt = (body = '') => body
  .replace(/^#{1,6}\s+/gm, '')
  .replace(/\[\[([^\]|]+)(?:\|([^\]]+))?\]\]/g, (_match, target, alias) => alias || target)
  .replace(/[*_`>]/g, '')
  .replace(/\s+/g, ' ')
  .trim()
  .slice(0, 180);

const items = [
  ...notes.map(note => ({
    id: note.id,
    title: note.data.title,
    date: note.data.date,
    url: `/notlar/${note.id}`,
    type: note.data.garden,
    typeLabel: GARDENS[note.data.garden].label,
    icon: GARDENS[note.data.garden].icon,
    description: toExcerpt(note.body),
    tags: note.data.tags,
  })),
  ...leaves.map(leaf => {
    const seed = seeds.find(candidate => candidate.id === leaf.data.seedRef);
    return {
      id: leaf.id,
      title: leaf.data.title,
      date: leaf.data.date,
      url: `/leaves/${leaf.id}`,
      type: 'yaprak',
      typeLabel: seed?.data.title || 'Yaprak',
      icon: '🍃',
      description: toExcerpt(leaf.body),
      tags: leaf.data.tags,
    };
  }),
].sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Base title="Külliyat — Yaşayan Orman" description="Abidin Yıldız’ın düşünce, günlük, kitap, oyun, hobi ve dijital bahçe notları.">
  <Sidebar />
  <main id="main-content" class="flex-1 h-full min-w-0 flex flex-col relative z-10">
    <TopNav />
    <div class="flex-1 overflow-y-auto overflow-x-hidden p-4 sm:p-6 lg:p-8 pb-20">
      <div class="max-w-6xl mx-auto">
        <div class="mb-8">
          <p class="text-xs font-bold uppercase tracking-[0.25em] text-forest-accent-light dark:text-forest-accent-dark mb-3">Arşiv</p>
          <h1 class="text-4xl md:text-5xl font-serif font-extrabold text-forest-text-light dark:text-forest-text-dark mb-3">Külliyat</h1>
          <p class="max-w-2xl text-forest-text-light/60 dark:text-forest-text-dark/60">Bahçenin tamamı: bağımsız notlar, günlükler, okuma ve oyun kayıtları ile ağaçlara bağlı yapraklar.</p>
        </div>

        <div class="flex flex-wrap gap-2 mb-8" aria-label="Külliyat filtreleri">
          <button type="button" class="library-filter px-4 py-2 rounded-full text-sm font-bold bg-forest-text-light text-white dark:bg-forest-accent-dark dark:text-black" data-library-filter="all" aria-pressed="true">Tümü <span class="opacity-70">{items.length}</span></button>
          {Object.entries(GARDENS).map(([key, garden]) => (
            <button type="button" class="library-filter px-4 py-2 rounded-full text-sm font-bold bg-black/5 dark:bg-white/5 text-forest-text-light/70 dark:text-forest-text-dark/70" data-library-filter={key} aria-pressed="false">{garden.icon} {garden.label}</button>
          ))}
          <button type="button" class="library-filter px-4 py-2 rounded-full text-sm font-bold bg-black/5 dark:bg-white/5 text-forest-text-light/70 dark:text-forest-text-dark/70" data-library-filter="yaprak" aria-pressed="false">🍃 Yapraklar</button>
        </div>

        <div id="library-grid" class="grid md:grid-cols-2 gap-5">
          {items.map(item => (
            <a href={item.url} data-library-type={item.type} class="dashboard-card group p-6 flex flex-col min-h-56">
              <div class="flex items-start justify-between gap-4 mb-5">
                <span class="w-11 h-11 rounded-xl bg-forest-accent-light/10 dark:bg-forest-accent-dark/10 flex items-center justify-center text-xl" aria-hidden="true">{item.icon}</span>
                <span class="text-xs font-bold text-forest-text-light/45 dark:text-forest-text-dark/45">{formatTimeSince(item.date)}</span>
              </div>
              <p class="text-xs font-bold uppercase tracking-widest text-forest-accent-light dark:text-forest-accent-dark mb-2">{item.typeLabel}</p>
              <h2 class="text-xl font-serif font-bold text-forest-text-light dark:text-forest-text-dark group-hover:text-forest-accent-light dark:group-hover:text-forest-accent-dark transition-colors mb-3">{item.title}</h2>
              <p class="text-sm text-forest-text-light/60 dark:text-forest-text-dark/60 leading-relaxed flex-1">{item.description || 'Bu kayıt henüz kısa bir nottan oluşuyor.'}</p>
              {item.tags.length > 0 && <p class="mt-5 text-xs font-mono text-forest-text-light/40 dark:text-forest-text-dark/40">{item.tags.slice(0, 4).map(tag => `#${tag}`).join(' · ')}</p>}
            </a>
          ))}
        </div>

        <p id="library-empty" class="hidden dashboard-card p-8 text-center text-forest-text-light/60 dark:text-forest-text-dark/60">Bu bölümde henüz kayıt yok.</p>
      </div>
    </div>
  </main>
</Base>

<script>
  const libraryButtons = [...document.querySelectorAll<HTMLButtonElement>('.library-filter')];
  const libraryItems = [...document.querySelectorAll<HTMLElement>('[data-library-type]')];
  const emptyMessage = document.getElementById('library-empty');

  libraryButtons.forEach(button => button.addEventListener('click', () => {
    const filter = button.dataset.libraryFilter || 'all';
    let visibleCount = 0;
    libraryButtons.forEach(candidate => {
      const active = candidate === button;
      candidate.setAttribute('aria-pressed', String(active));
      candidate.classList.toggle('bg-forest-text-light', active);
      candidate.classList.toggle('text-white', active);
      candidate.classList.toggle('dark:bg-forest-accent-dark', active);
      candidate.classList.toggle('dark:text-black', active);
      candidate.classList.toggle('bg-black/5', !active);
      candidate.classList.toggle('dark:bg-white/5', !active);
    });
    libraryItems.forEach(item => {
      const visible = filter === 'all' || item.dataset.libraryType === filter;
      item.hidden = !visible;
      if (visible) visibleCount += 1;
    });
    emptyMessage?.classList.toggle('hidden', visibleCount > 0);
  }));
</script>
