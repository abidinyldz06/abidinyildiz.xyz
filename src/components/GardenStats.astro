---
import { getCollection } from 'astro:content';
const notes = await getCollection('notes');

const totalNotes = notes.length;
const totalWords = notes.reduce((acc, note) => {
  return acc + (note.body ? note.body.split(/\s+/).length : 0);
}, 0);
const uniqueGardens = new Set(notes.map(n => n.data.garden)).size;
---
<div class="glass-card mt-16 p-6 flex flex-wrap items-center justify-center gap-x-8 gap-y-4 text-sm font-sans font-medium text-earth/80 dark:text-moss/80 border-t border-earth/20 dark:border-moss/20">
  <div class="flex items-center gap-2">
    <span class="text-xl">🌿</span>
    <span><strong class="text-ink dark:text-night-text">{totalNotes}</strong> ekilen tohum</span>
  </div>
  <div class="hidden sm:block w-1.5 h-1.5 rounded-full bg-earth/30 dark:bg-moss/30"></div>
  <div class="flex items-center gap-2">
    <span class="text-xl">🪴</span>
    <span><strong class="text-ink dark:text-night-text">{uniqueGardens}</strong> farklı tür</span>
  </div>
  <div class="hidden sm:block w-1.5 h-1.5 rounded-full bg-earth/30 dark:bg-moss/30"></div>
  <div class="flex items-center gap-2">
    <span class="text-xl">💧</span>
    <span><strong class="text-ink dark:text-night-text">~{totalWords}</strong> damla su (kelime)</span>
  </div>
</div>
