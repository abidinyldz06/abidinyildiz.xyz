---
import * as nowFile from '../content/now.md';
const now = nowFile.frontmatter;
---

<div class="relative w-full overflow-hidden glass-card p-8 mb-16 group">
  <!-- Wooden/Organic Accent Line -->
  <div class="absolute top-0 left-0 w-2 h-full bg-earth/80 dark:bg-moss/80"></div>
  
  <!-- Subtle inner shadow/gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-white/40 to-transparent dark:from-white/5 opacity-50 pointer-events-none"></div>

  <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-8">
    <div class="flex-1">
      <div class="flex items-center gap-3 mb-6">
        <span class="text-3xl animate-float">🌱</span>
        <h2 class="font-serif text-3xl font-bold text-forest dark:text-moss tracking-wide">Şu Anki İklim</h2>
      </div>
      
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-6 font-sans text-sm">
        <li class="flex items-start gap-4 p-3 rounded-xl hover:bg-forest/5 dark:hover:bg-moss/10 transition-colors">
          <span class="text-2xl leading-none pt-1 opacity-80">🎮</span>
          <div>
            <span class="text-earth/80 dark:text-moss/70 text-[10px] uppercase font-bold tracking-widest block mb-1">Toprakta Büyüyen</span>
            <span class="text-ink dark:text-night-text font-medium text-base">{now.playing}</span>
          </div>
        </li>
        <li class="flex items-start gap-4 p-3 rounded-xl hover:bg-forest/5 dark:hover:bg-moss/10 transition-colors">
          <span class="text-2xl leading-none pt-1 opacity-80">📖</span>
          <div>
            <span class="text-earth/80 dark:text-moss/70 text-[10px] uppercase font-bold tracking-widest block mb-1">Besin Kaynağı</span>
            <span class="text-ink dark:text-night-text font-medium text-base">{now.reading}</span>
          </div>
        </li>
        <li class="flex items-start gap-4 p-3 rounded-xl hover:bg-forest/5 dark:hover:bg-moss/10 transition-colors">
          <span class="text-2xl leading-none pt-1 opacity-80">💼</span>
          <div>
            <span class="text-earth/80 dark:text-moss/70 text-[10px] uppercase font-bold tracking-widest block mb-1">Gündelik Budama</span>
            <span class="text-ink dark:text-night-text font-medium text-base">{now.work}</span>
          </div>
        </li>
        <li class="flex items-start gap-4 p-3 rounded-xl hover:bg-forest/5 dark:hover:bg-moss/10 transition-colors">
          <span class="text-2xl leading-none pt-1 opacity-80">🌤️</span>
          <div>
            <span class="text-earth/80 dark:text-moss/70 text-[10px] uppercase font-bold tracking-widest block mb-1">Gökyüzü Durumu</span>
            <span class="text-ink dark:text-night-text font-medium text-base">{now.mood}</span>
          </div>
        </li>
      </ul>
    </div>
  </div>
</div>
