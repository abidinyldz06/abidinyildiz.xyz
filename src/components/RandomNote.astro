---
import { getCollection } from 'astro:content';

const notes = await getCollection('notes');
const randomNote = notes[Math.floor(Math.random() * notes.length)];
---

<a href={`/notes/${randomNote.id}`} class="group relative inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-gradient-to-r from-forest/10 to-moss/10 dark:from-forest/20 dark:to-moss/20 hover:from-forest hover:to-moss text-forest dark:text-moss hover:text-white dark:hover:text-night rounded-full transition-all duration-300 shadow-sm hover:shadow-md hover:shadow-forest/20 dark:hover:shadow-moss/20 border border-forest/20 dark:border-moss/20 font-sans text-sm font-semibold overflow-hidden" title="Rastgele Bir Not Oku">
  <span class="absolute inset-0 bg-white/20 dark:bg-black/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300"></span>
  <span class="text-xl group-hover:rotate-180 transition-transform duration-500 relative z-10">🎲</span>
  <span class="relative z-10 tracking-wide">Rastgele Filiz</span>
</a>
