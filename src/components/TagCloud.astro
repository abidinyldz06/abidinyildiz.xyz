---
import { getCollection } from 'astro:content';

const notes = await getCollection('notes');
const allTags = notes.map(n => n.data.tags).flat();
const uniqueTags = [...new Set(allTags)];
---

<div class="flex flex-wrap gap-2.5">
  {uniqueTags.map(tag => (
    <a href={`/tags/${tag}`} class="group relative px-3 py-1.5 text-xs font-mono font-medium text-earth/80 dark:text-moss/80 bg-earth/5 dark:bg-moss/5 border border-earth/20 dark:border-moss/20 rounded-lg hover:bg-earth/20 dark:hover:bg-moss/20 hover:text-ink dark:hover:text-night-text transition-all duration-300 shadow-sm">
      <span class="opacity-50 mr-0.5 group-hover:text-forest dark:group-hover:text-moss transition-colors">#</span>{tag}
    </a>
  ))}
</div>
