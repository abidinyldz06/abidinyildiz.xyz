---
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Bahçe' },
  { href: '/kulliyat', label: 'Külliyat' },
  { href: '/gelisim', label: 'Gelişim' },
  { href: '/simdi', label: 'Şimdi' },
];

const isActive = (href: string) => href === '/'
  ? currentPath === '/'
  : currentPath.startsWith(href);
---

<header class="h-20 w-full shrink-0 flex items-center justify-between px-4 sm:px-6 lg:px-8 relative z-20">
  <a href="/" class="flex items-center gap-2 min-w-0" aria-label="Yaşayan Orman ana sayfa">
    <span aria-hidden="true">🌲</span>
    <span class="text-xl sm:text-2xl font-serif font-bold text-forest-text-light dark:text-forest-text-dark glow-text tracking-tight truncate">Yaşayan Orman</span>
  </a>
  
  <nav aria-label="Ana navigasyon" class="hidden xl:flex items-center gap-7 text-sm font-medium text-forest-text-light/60 dark:text-forest-text-dark/60 uppercase tracking-widest">
    {navItems.map(item => (
      <a
        href={item.href}
        aria-current={isActive(item.href) ? 'page' : undefined}
        class:list={[
          'pb-1 transition-colors hover:text-forest-text-light dark:hover:text-forest-text-dark',
          isActive(item.href) && 'text-forest-accent-light dark:text-forest-accent-dark border-b-2 border-forest-accent-light dark:border-forest-accent-dark',
        ]}
      >
        {item.label}
      </a>
    ))}
  </nav>

  <div class="flex items-center gap-2 sm:gap-3">
    <button id="search-btn" type="button" aria-label="Sitede ara" aria-haspopup="dialog" class="w-10 h-10 rounded-full bg-black/5 dark:bg-white/5 flex items-center justify-center text-forest-text-light dark:text-forest-text-dark hover:bg-forest-text-light/10 dark:hover:bg-white/10 transition-colors relative">
      <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      <span aria-hidden="true" class="absolute -top-1 -right-1 text-[8px] bg-forest-accent-light dark:bg-forest-accent-dark text-black px-1.5 py-0.5 rounded-full font-bold shadow-lg">/</span>
    </button>
    
    <ThemeToggle />

    <a href="/hesap" aria-label="Profil ve ayarlar" class="hidden sm:block w-8 h-8 rounded-full bg-forest-accent-light/20 border border-forest-accent-light/50 dark:border-forest-accent-dark/50 overflow-hidden shadow-[0_0_10px_rgba(74,222,128,0.2)]">
      <img id="topnav-avatar" src="/avatars/caretaker.png" alt="" class="w-full h-full object-cover" />
    </a>
    
    <button id="mobile-menu-btn" type="button" aria-label="Menüyü aç" aria-controls="mobile-drawer" aria-expanded="false" class="xl:hidden text-forest-text-light dark:text-forest-text-dark p-2">
      <svg aria-hidden="true" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
    </button>
  </div>
</header>

<div id="search-modal" role="dialog" aria-modal="true" aria-labelledby="search-title" aria-hidden="true" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[60] flex items-start justify-center pt-20 sm:pt-24 hidden opacity-0 transition-opacity">
  <div class="bg-forest-bg-light dark:bg-forest-bg-dark w-full max-w-2xl rounded-2xl shadow-2xl border border-forest-accent-light/20 dark:border-forest-accent-dark/20 overflow-hidden flex flex-col transform -translate-y-4 transition-transform duration-300 mx-4" id="search-modal-content">
    <h2 id="search-title" class="sr-only">Sitede ara</h2>
    <div class="p-4 border-b border-black/10 dark:border-white/10 flex items-center gap-3">
      <svg aria-hidden="true" class="w-6 h-6 text-forest-text-light/50 dark:text-forest-text-dark/50 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      <label for="search-input" class="sr-only">Tohum, yaprak veya not ara</label>
      <input type="search" id="search-input" autocomplete="off" placeholder="Tohum, yaprak veya not ara..." class="flex-1 min-w-0 bg-transparent outline-none text-base sm:text-xl text-forest-text-light dark:text-forest-text-dark placeholder-forest-text-light/30 dark:placeholder-forest-text-dark/30" />
      <button id="close-search-btn" type="button" aria-label="Aramayı kapat" class="p-2 text-forest-text-light/50 hover:text-forest-text-light dark:text-forest-text-dark/50 dark:hover:text-forest-text-dark rounded-xl bg-black/5 dark:bg-white/5 font-mono text-xs">ESC</button>
    </div>
    <div class="max-h-[60vh] overflow-y-auto p-2" id="search-results" aria-live="polite">
      <div class="p-8 text-center text-forest-text-light/40 dark:text-forest-text-dark/40 font-medium">Aramaya başlamak için yazın...</div>
    </div>
  </div>
</div>

<div id="mobile-drawer" aria-hidden="true" inert class="fixed inset-0 bg-forest-bg-light/98 dark:bg-forest-bg-dark/98 z-50 transform translate-x-full transition-transform duration-300 xl:hidden flex flex-col pt-20 px-8">
  <button id="close-drawer-btn" type="button" aria-label="Menüyü kapat" class="absolute top-6 right-6 sm:right-8 text-forest-text-light dark:text-forest-text-dark p-2">
    <svg aria-hidden="true" class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
  </button>
  <nav aria-label="Mobil navigasyon" class="flex flex-col gap-2 text-lg font-medium text-forest-text-light dark:text-forest-text-dark">
    {navItems.map(item => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined} class:list={['rounded-xl px-4 py-3 transition-colors', isActive(item.href) ? 'bg-forest-accent-light/10 dark:bg-forest-accent-dark/10 text-forest-accent-light dark:text-forest-accent-dark' : 'hover:bg-black/5 dark:hover:bg-white/5']}>{item.label}</a>
    ))}
    <a href="/ekosistem" class="rounded-xl px-4 py-3 hover:bg-black/5 dark:hover:bg-white/5">Ekosistem</a>
    <a href="/yapraklar" class="rounded-xl px-4 py-3 hover:bg-black/5 dark:hover:bg-white/5">Tüm Yapraklar</a>
    <a href="/hesap" class="rounded-xl px-4 py-3 hover:bg-black/5 dark:hover:bg-white/5">Profil ve Ayarlar</a>
  </nav>
</div>

<script>
  import Fuse from 'fuse.js';

  interface SearchItem {
    title: string;
    description: string;
    type: string;
    url: string;
    icon: string;
  }

  const escapeHTML = (value: string) => value.replace(/[&<>'"]/g, character => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
  })[character] || character);

  const storedCaretaker = localStorage.getItem('caretaker');
  if (storedCaretaker) {
    try {
      const caretaker = JSON.parse(storedCaretaker);
      const avatar = document.getElementById('topnav-avatar') as HTMLImageElement | null;
      if (avatar && typeof caretaker.avatar === 'string') avatar.src = caretaker.avatar;
    } catch {}
  }

  const menuButton = document.getElementById('mobile-menu-btn');
  const closeDrawerButton = document.getElementById('close-drawer-btn');
  const drawer = document.getElementById('mobile-drawer');

  const setDrawer = (open: boolean) => {
    drawer?.classList.toggle('translate-x-full', !open);
    drawer?.setAttribute('aria-hidden', String(!open));
    drawer?.toggleAttribute('inert', !open);
    menuButton?.setAttribute('aria-expanded', String(open));
    if (open) closeDrawerButton?.focus();
  };

  menuButton?.addEventListener('click', () => setDrawer(true));
  closeDrawerButton?.addEventListener('click', () => setDrawer(false));

  const searchButton = document.getElementById('search-btn');
  const searchModal = document.getElementById('search-modal');
  const searchModalContent = document.getElementById('search-modal-content');
  const closeSearchButton = document.getElementById('close-search-btn');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchResults = document.getElementById('search-results');

  let fuse: Fuse<SearchItem> | null = null;

  const openSearch = async () => {
    if (!searchModal) return;
    searchModal.classList.remove('hidden');
    searchModal.setAttribute('aria-hidden', 'false');
    window.setTimeout(() => {
      searchModal.classList.remove('opacity-0');
      searchModalContent?.classList.remove('-translate-y-4');
      searchInput?.focus();
    }, 10);

    if (!fuse) {
      if (searchResults) searchResults.innerHTML = '<div class="p-8 text-center text-forest-text-light/50 dark:text-forest-text-dark/50">Arama dizini yükleniyor...</div>';
      try {
        const response = await fetch('/api/search.json');
        if (!response.ok) throw new Error('Arama dizini alınamadı');
        const searchData = await response.json() as SearchItem[];
        fuse = new Fuse(searchData, { keys: ['title', 'description', 'type'], threshold: 0.3, ignoreLocation: true });
        if (searchResults) searchResults.innerHTML = '<div class="p-8 text-center text-forest-text-light/40 dark:text-forest-text-dark/40 font-medium">Aramaya başlamak için yazın...</div>';
      } catch {
        if (searchResults) searchResults.innerHTML = '<div class="p-8 text-center text-red-600 dark:text-red-400">Arama şu anda yüklenemiyor.</div>';
      }
    }
  };

  const closeSearch = () => {
    if (!searchModal) return;
    searchModal.classList.add('opacity-0');
    searchModalContent?.classList.add('-translate-y-4');
    searchModal.setAttribute('aria-hidden', 'true');
    window.setTimeout(() => searchModal.classList.add('hidden'), 300);
    if (searchInput) searchInput.value = '';
    searchButton?.focus();
  };

  searchButton?.addEventListener('click', openSearch);
  closeSearchButton?.addEventListener('click', closeSearch);
  searchModal?.addEventListener('click', event => {
    if (event.target === searchModal) closeSearch();
  });

  document.addEventListener('keydown', event => {
    const target = document.activeElement?.tagName;
    if ((event.key === 'k' && (event.ctrlKey || event.metaKey)) || (event.key === '/' && target !== 'INPUT' && target !== 'TEXTAREA')) {
      event.preventDefault();
      openSearch();
    }
    if (event.key === 'Escape') {
      if (searchModal?.getAttribute('aria-hidden') === 'false') closeSearch();
      setDrawer(false);
    }
  });

  searchInput?.addEventListener('input', event => {
    if (!searchResults) return;
    const query = (event.target as HTMLInputElement).value.trim();
    if (!query) {
      searchResults.innerHTML = '<div class="p-8 text-center text-forest-text-light/40 dark:text-forest-text-dark/40 font-medium">Aramaya başlamak için yazın...</div>';
      return;
    }
    if (!fuse) return;

    const results = fuse.search(query).slice(0, 12);
    if (results.length === 0) {
      searchResults.innerHTML = '<div class="p-8 text-center text-forest-text-light/40 dark:text-forest-text-dark/40 font-medium">Sonuç bulunamadı.</div>';
      return;
    }

    searchResults.innerHTML = results.map(({ item }) => `
      <a href="${escapeHTML(item.url)}" class="flex items-center gap-4 p-3 hover:bg-black/5 dark:hover:bg-white/5 rounded-xl transition-colors group">
        <span class="w-10 h-10 rounded-full bg-forest-accent-light/10 dark:bg-forest-accent-dark/10 flex items-center justify-center text-xl shrink-0">${escapeHTML(item.icon)}</span>
        <span class="flex-1 min-w-0">
          <span class="flex items-center gap-2">
            <strong class="text-forest-text-light dark:text-forest-text-dark truncate">${escapeHTML(item.title)}</strong>
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-forest-accent-light/10 dark:bg-forest-accent-dark/10 text-forest-accent-light dark:text-forest-accent-dark font-bold uppercase tracking-wider">${escapeHTML(item.type)}</span>
          </span>
          <span class="block text-xs text-forest-text-light/50 dark:text-forest-text-dark/50 truncate mt-1">${escapeHTML(item.description || '').slice(0, 120)}</span>
        </span>
        <span aria-hidden="true" class="text-forest-text-light/30 dark:text-forest-text-dark/30">→</span>
      </a>
    `).join('');
  });
</script>
